---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import { experience, site } from '../data/site';
---
<Layout title="Experience"><div class="page-scene"><Scene priority /></div><section class="wrap page-content"><div class="page-heading"><p class="eyebrow">Career / 02</p><h1>Built through<br />experience.</h1><p class="intro">Engineering, leadership, and production delivery.</p></div><div class="timeline">{experience.map(job => <article class="timeline-item"><div class="timeline-date">{job.start}<span>{job.end}</span></div><div class="timeline-content"><span class="timeline-dot" aria-hidden="true"></span><h2>{job.role}</h2><h3>{job.company}</h3><p class="job-type">{job.type}</p><p>{job.description}</p><div class="tags">{job.tags.map(tag=><span>{tag}</span>)}</div>{job.milestones && <details><summary>View progression</summary><ul>{job.milestones.map(m=><li><span>{m.period}</span>{m.title}</li>)}</ul></details>}</div></article>)}</div><a class="button" href={site.resume} download>Download résumé</a></section></Layout>
