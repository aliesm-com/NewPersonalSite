---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import { site } from '../data/site';
import { getCollection } from 'astro:content';
const experiments=(await getCollection('experiments')).sort((a,b)=>a.data.order-b.data.order);
---
<Layout title="Lab"><div class="page-scene"><Scene priority /></div><section class="wrap page-content lab-page"><div class="page-heading"><p class="eyebrow">The Lab / 03</p><h1>Ideas in progress.</h1><p class="lead narrow">Tools, side projects, and things<br class="desktop-only" /> I build out of curiosity.</p></div><div class="lab-grid">{experiments.map((entry,i)=><article class="lab-item"><span class="eyebrow">0{i+1} / Project</span><h2>{entry.data.title}</h2>{entry.data.url && <a class="text-link" href={entry.data.url} target="_blank" rel="noopener noreferrer">Explore project</a>}</article>)}<div class="lab-item lab-note"><h2>From sketch<br />to prototype.</h2><p>A space for trying,<br />learning, and building.</p></div></div><a class="button" href={site.github} target="_blank" rel="noopener noreferrer">Explore on GitHub</a></section></Layout>
