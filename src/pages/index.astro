---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import Thumb from '../components/Thumb.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({data}) => data.featured)).sort((a,b) => a.data.order-b.data.order);
---
<Layout>
  <section class="hero">
    <Scene name="hero-study" mobileName="hero-portrait" priority variant="hero-scene" />
    <div class="hero-content wrap">
      <p class="eyebrow">Backend <span>/</span> AI systems <span>/</span> Platform engineering</p>
      <h1>Ali Esmaeili<span>Senior Software Engineer</span></h1>
      <div class="small-rule"></div>
      <p class="hero-description">I design and build scalable backend systems, AI-powered products, and developer platforms that turn complex ideas into real-world impact.</p>
      <div class="actions">
        <a class="button" href="/projects/">Explore my work</a>
        <a class="text-link" href="/about/">The person behind the code</a>
      </div>
    </div>
    <div class="hotspots" aria-label="Explore the study">
      <a class="hotspot project-spot" href="/projects/"><span class="glow-dot"></span><span>Projects</span></a>
      <a class="hotspot experience-spot" href="/experience/"><span class="glow-dot"></span><span>Experience</span></a>
      <a class="hotspot media-spot" href="/media/"><span class="glow-dot"></span><span>Media</span></a>
      <a class="hotspot lab-spot" href="/lab/"><span class="glow-dot"></span><span>Lab</span></a>
    </div>
    <div class="hero-bottom wrap">
      <a href="#selected" class="scroll-cue"><span class="mouse-icon" aria-hidden="true"></span>Scroll to discover</a>
      <span class="micro">Engineering with curiosity.</span>
    </div>
  </section>
  <section class="section wrap" id="selected">
    <div class="section-heading"><div><p class="eyebrow">01 / Selected work</p><h2>From ideas to working systems.</h2></div><a class="text-link" href="/projects/">All projects</a></div>
    <div class="project-grid">{projects.map((project, i) => <a href={`/projects/${project.id}/`} class="project-card"><div class="image-frame"><Thumb name={project.data.image} alt="Warmly lit engineering workspace" /><span class="image-index">0{i+1}</span><span class="image-category">{project.data.category}</span></div><h3>{project.data.title}</h3><p>{project.data.summary}</p><span class="text-link">View project</span></a>)}</div>
  </section>
  <section class="split-story wrap section"><div><p class="eyebrow">Beyond the code</p><h2>Some stories deserve<br /><em>to be heard.</em></h2></div><div><p>Curiosity also takes me beyond engineering. Logdio explores mysteries and unusual cases. Bugdio shares the stories, bugs, and lessons of a programmer’s life.</p><a class="button" href="/media/">Discover the podcasts</a></div></section>
</Layout>
