---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import Thumb from '../../components/Thumb.astro';
import { getCollection } from 'astro:content';
const podcasts = (await getCollection('podcasts')).sort((a,b)=>a.data.order-b.data.order);
---
<Layout title="Media & Podcasts"><div class="page-scene"><Scene name="podcast-studio" priority variant="media-scene" /></div><section class="wrap page-content"><div class="page-heading"><p class="eyebrow">Media / Podcasts</p><h1>Stories beyond the code.</h1><p class="intro">Two podcasts. Different worlds. The same curiosity.</p></div><div class="podcast-grid">{podcasts.map(podcast=><article class="podcast-card"><a class="podcast-cover" href={`/media/${podcast.id}/`} aria-label={`Discover ${podcast.data.title}`}><Thumb name={podcast.data.image} alt={podcast.id==='logdio'?'A dark study with notes and warm light':'A warm podcast recording studio'} /><div class:list={['cover-title',podcast.id]}><span>{podcast.data.title}</span><span lang="fa" dir="rtl">{podcast.data.persianTitle}</span></div><span class="cover-label">A podcast by Ali Esmaeili</span></a><div class="podcast-info"><p class="eyebrow">{podcast.data.subtitle}</p><h2>{podcast.data.title}</h2><p>{podcast.data.summary}</p><a class="text-link" href={`/media/${podcast.id}/`}>Discover the podcast</a></div></article>)}</div></section></Layout>
