---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('podcasts')).map(entry=>({params:{id:entry.id},props:{entry}})); }
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<Layout title={entry.data.title} description={entry.data.summary}><div class="page-scene"><Scene name={entry.data.image} priority /></div><article class="wrap page-content podcast-detail"><a class="back-link" href="/media/">All podcasts</a><div class="page-heading"><p class="eyebrow">{entry.data.subtitle}</p><h1>{entry.data.title}<span class="podcast-persian" lang="fa" dir="rtl">{entry.data.persianTitle}</span></h1><p class="lead narrow">{entry.data.summary}</p><div class="tags">{entry.data.topics.map(topic=><span>{topic}</span>)}</div></div><div class="prose"><Content /></div>{entry.data.listenUrl && <a class="button" href={entry.data.listenUrl} target="_blank" rel="noopener noreferrer">Listen to {entry.data.title}</a>}{entry.data.episodes.length > 0 && <section class="episodes"><p class="eyebrow">Episodes</p>{entry.data.episodes.map(episode=><article><h2>{episode.title}</h2>{episode.description && <p>{episode.description}</p>}{episode.audioSrc && <audio controls preload="none" src={episode.audioSrc}>Your browser does not support audio.</audio>}{episode.url && <a class="text-link" href={episode.url} target="_blank" rel="noopener noreferrer">Episode details</a>}</article>)}</section>}<a class="text-link section-link" href={`/media/${entry.id==='logdio'?'bugdio':'logdio'}/`}>Discover {entry.id==='logdio'?'Bugdio':'Logdio'}</a></article></Layout>
