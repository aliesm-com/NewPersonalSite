---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import Thumb from '../../components/Thumb.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: { entry, next: entries[(index + 1) % entries.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const iconKinds = ['chip', 'network', 'database'] as const;
---
<Layout title={entry.data.title} description={entry.data.summary}>
  <div class="page-scene">
    <Scene name={entry.data.image} priority variant="muted-scene" />
  </div>
  <article class="wrap page-content case-study">
    <div class="case-layout">
      <div class="case-copy">
        <p class="eyebrow">Projects <span>/</span> {entry.data.title}</p>
        <a class="back-link" href="/projects/">← All projects</a>
        <h1>{entry.data.title}<span class="gold">.</span></h1>
        <p class="lead">{entry.data.summary}</p>

        {entry.data.challenge && (
          <section class="case-block">
            <p class="eyebrow">The challenge</p>
            <p class="case-challenge">{entry.data.challenge}</p>
          </section>
        )}

        <section class="case-block">
          <p class="eyebrow">My contribution</p>
          <ul class="contribution-list">
            {entry.data.contributions.map((item, i) => (
              <li>
                <span class="contrib-icon" data-kind={iconKinds[i % iconKinds.length]} aria-hidden="true">
                  {iconKinds[i % iconKinds.length] === 'chip' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                      <rect x="7" y="7" width="10" height="10" rx="1.5"></rect>
                      <path d="M9 1v3M12 1v3M15 1v3M9 20v3M12 20v3M15 20v3M1 9h3M1 12h3M1 15h3M20 9h3M20 12h3M20 15h3"></path>
                      <rect x="10" y="10" width="4" height="4" rx="0.5"></rect>
                    </svg>
                  )}
                  {iconKinds[i % iconKinds.length] === 'network' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                      <circle cx="12" cy="5" r="2.2"></circle>
                      <circle cx="5" cy="18" r="2.2"></circle>
                      <circle cx="19" cy="18" r="2.2"></circle>
                      <path d="M10.2 6.6 6.4 16.2M13.8 6.6l3.8 9.6M7.2 18h9.6"></path>
                    </svg>
                  )}
                  {iconKinds[i % iconKinds.length] === 'database' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                      <ellipse cx="12" cy="6" rx="7" ry="3"></ellipse>
                      <path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"></path>
                      <path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"></path>
                    </svg>
                  )}
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <dl class="case-meta case-meta--inline">
          <div>
            <dt>Role</dt>
            <dd>{entry.data.role}</dd>
          </div>
          <div>
            <dt>Stack</dt>
            <dd>{entry.data.tags.join(' · ')}</dd>
          </div>
          <div>
            <dt>Context</dt>
            <dd>{entry.data.context}</dd>
          </div>
        </dl>

        <div class="case-actions">
          {entry.data.url && (
            <a class="button" href={entry.data.url} target="_blank" rel="noopener noreferrer">Visit project</a>
          )}
          <a class="button" href={`/projects/${next.id}/`}>Next project →</a>
        </div>
      </div>

      <div class="case-showcase">
        <div class="case-visual">
          <Thumb name={entry.data.image} alt="An engineering study, illustrating the project’s working environment" />
        </div>
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

    {entry.data.pipeline.length > 0 && (
      <section class="case-pipeline" aria-label="System flow">
        {entry.data.pipeline.map((stage, index) => (
          <div class="pipeline-item">
            <div class="pipeline-stage">
              <span class="pipeline-glyph" data-step={index % 3} aria-hidden="true">
                {index % 3 === 0 && (
                  <svg viewBox="0 0 48 28" fill="none" stroke="currentColor" stroke-width="1.1">
                    <rect x="2" y="8" width="12" height="14" rx="2"></rect>
                    <rect x="18" y="4" width="12" height="18" rx="2"></rect>
                    <rect x="34" y="10" width="12" height="12" rx="2"></rect>
                    <circle cx="8" cy="13" r="1" fill="currentColor" stroke="none"></circle>
                    <circle cx="24" cy="10" r="1" fill="currentColor" stroke="none"></circle>
                    <circle cx="40" cy="14" r="1" fill="currentColor" stroke="none"></circle>
                  </svg>
                )}
                {index % 3 === 1 && (
                  <svg viewBox="0 0 48 28" fill="none" stroke="currentColor" stroke-width="1.1">
                    <rect x="2" y="4" width="10" height="20" rx="2"></rect>
                    <rect x="14" y="4" width="10" height="20" rx="2"></rect>
                    <path d="M28 14h6"></path>
                    <ellipse cx="40" cy="14" rx="6" ry="4"></ellipse>
                    <path d="M34 14c0 2.2 2.7 4 6 4s6-1.8 6-4"></path>
                  </svg>
                )}
                {index % 3 === 2 && (
                  <svg viewBox="0 0 48 28" fill="none" stroke="currentColor" stroke-width="1.1">
                    <rect x="8" y="3" width="32" height="22" rx="2.5"></rect>
                    <path d="M14 20h4M20 16v4M26 12v8M32 9v11"></path>
                  </svg>
                )}
              </span>
              <strong>{stage.label}</strong>
              {stage.caption && <span>{stage.caption}</span>}
            </div>
            {index < entry.data.pipeline.length - 1 && (
              <span class="pipeline-arrow" aria-hidden="true">→</span>
            )}
          </div>
        ))}
      </section>
    )}
  </article>
</Layout>
