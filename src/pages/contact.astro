---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import ContactForm from '../components/ContactForm';
import {site} from '../data/site';
---
<Layout title="Contact"><div class="page-scene"><Scene priority /></div><section class="wrap page-content contact-layout"><div class="page-heading"><p class="eyebrow">Contact / 05</p><h1>Let's build<br />something<br /><em>meaningful.</em></h1><p class="intro">Have a project, an engineering challenge,<br class="desktop-only" /> or an idea worth exploring?</p><a class="email-link" href={`mailto:${site.email}`}>{site.email}</a><div class="actions"><a class="button compact" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a class="button compact" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a></div><p class="availability">Remote · Open to relocation</p></div><ContactForm email={site.email} client:visible /></section></Layout>
