---
interface Props { name: string; alt: string; class?: string; }
const { name, alt, class: className } = Astro.props;
---
<picture class={className}>
  <source type="image/avif" srcset={`/images/${name}-640.avif 640w, /images/${name}-1024.avif 1024w`} sizes="(max-width: 700px) 92vw, 40vw" />
  <img src={`/images/${name}-640.webp`} srcset={`/images/${name}-640.webp 640w, /images/${name}-1024.webp 1024w`} sizes="(max-width: 700px) 92vw, 40vw" width="1024" height="576" alt={alt} loading="lazy" decoding="async" />
</picture>
